  "item": [
    {
      "name": "AutomationOrchestratorService",
      "item": [
        {
          "name": "Опубликовать сценарий в runtime",
          "protocolProfileBehavior": {
            "followRedirects": true,
            "disableUrlEncoding": false,
            "disableCookies": false
          },
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{ _.base_url }}/api/v1/scenarios/:scenarioId/publish",
              "host": [
                "{{ _.base_url }}"
              ],
              "path": [
                "api",
                "v1",
                "scenarios",
                ":scenarioId",
                "publish"
              ],
              "variable": [
                {
                  "key": "scenarioId"
                }
              ]
            },
            "description": "Передаёт валидный и активный сценарий в CommandExecutionService для исполнения. Возвращает ошибку 409, если сценарий отключён или содержит невалидные ссылки на устройства.\n"
          },
          "response": []
        },
        {
          "name": "Создать сценарий автоматизации",
          "protocolProfileBehavior": {
            "followRedirects": true,
            "disableUrlEncoding": false,
            "disableCookies": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"houseId\": \"string\",\n  \"name\": \"string\",\n  \"enabled\": true,\n  \"triggers\": [\n    {\n      \"sourceDeviceId\": \"string\",\n      \"capabilityId\": \"string\",\n      \"operator\": \"string\",\n      \"value\": \"string\"\n    }\n  ],\n  \"conditions\": [\n    {\n      \"sourceDeviceId\": \"string\",\n      \"capabilityId\": \"string\",\n      \"operator\": \"string\",\n      \"value\": \"string\"\n    }\n  ],\n  \"actions\": [\n    {\n      \"targetDeviceId\": \"string\",\n      \"capabilityId\": \"string\",\n      \"action\": \"string\",\n      \"value\": \"string\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{ _.base_url }}/api/v1/scenarios",
              "host": [
                "{{ _.base_url }}"
              ],
              "path": [
                "api",
                "v1",
                "scenarios"
              ]
            },
            "description": "Создаёт новый сценарий автоматизации с триггером, условиями и действиями. Сценарий сохраняется в черновом состоянии и не исполняется до публикации.\n"
          },
          "response": []
        }
      ],
      "description": "AutomationOrchestratorService — создание и публикация сценариев автоматизации"
    },
    {
      "name": "CommandExecutionService",
      "item": [
        {
          "name": "Отправить ручную команду устройству",
          "protocolProfileBehavior": {
            "followRedirects": true,
            "disableUrlEncoding": false,
            "disableCookies": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"string\",\n  \"capability\": \"string\",\n  \"action\": \"string\",\n  \"value\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{ _.base_url }}/api/v1/commands",
              "host": [
                "{{ _.base_url }}"
              ],
              "path": [
                "api",
                "v1",
                "commands"
              ]
