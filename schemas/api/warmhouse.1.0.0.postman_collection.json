            "followRedirects": true,
            "disableUrlEncoding": false,
            "disableCookies": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"string\",\n  \"capability\": \"string\",\n  \"action\": \"string\",\n  \"value\": \"string\",\n  \"commandId\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{ _.base_url }}/api/v1/device-commands",
